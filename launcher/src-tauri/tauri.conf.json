{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWBF2 Recomp Hub",
  "version": "1.0.0",
  "identifier": "org.swbf2recomp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Star Wars Battlefront II - Desktop Hub",
        "width": 980,
        "height": 640,
        "minWidth": 800,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
